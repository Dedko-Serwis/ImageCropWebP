<Window x:Class="ImageCropWebP.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ImageCrop WebP" Width="1150" Height="780" MinWidth="850" MinHeight="570" Background="#F3F5F9" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" KeyDown="Window_KeyDown">
 <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
  <Border Background="#222833" CornerRadius="10" ClipToBounds="True" Margin="0,0,16,0">
   <Grid><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"><Grid x:Name="ImageSurface" MouseLeftButtonDown="Surface_Down" MouseMove="Surface_Move" MouseLeftButtonUp="Surface_Up" MouseLeave="Surface_Leave" Background="#303846" Cursor="Cross"><Image x:Name="Photo" Stretch="Fill"/><Canvas x:Name="Overlay" IsHitTestVisible="False"><Rectangle x:Name="CropBox" Stroke="#FFFFFF" StrokeThickness="2" Fill="#30FFFFFF" Visibility="Collapsed"/><Rectangle x:Name="CropOutline" Stroke="#111827" StrokeDashArray="5,4" StrokeThickness="1" Visibility="Collapsed"/></Canvas></Grid></ScrollViewer><TextBlock x:Name="EmptyHint" Text="Przeciągnij tutaj obraz albo kliknij Otwórz" Foreground="#DCE3EC" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="18"/></Grid>
  </Border>
  <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="17"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="ImageCrop WebP" FontWeight="Bold" FontSize="22" Margin="0,0,0,14"/>
   <Button Content="Otwórz obraz (Ctrl+O)" Click="Open_Click" Padding="8" Margin="0,0,0,6"/>
   <Button Content="Wklej ze schowka (Ctrl+V)" Click="Paste_Click" Padding="8" Margin="0,0,0,16"/>
   <TextBlock Text="Proporcje kadru" FontWeight="SemiBold"/>
   <ComboBox x:Name="RatioBox" SelectionChanged="Ratio_Changed" SelectedIndex="4" Margin="0,7,0,8"><ComboBoxItem Content="Dowolne" Tag="0"/><ComboBoxItem Content="1:1" Tag="1"/><ComboBoxItem Content="4:3" Tag="1.333333333333"/><ComboBoxItem Content="3:2" Tag="1.5"/><ComboBoxItem Content="16:9" Tag="1.777777777778"/><ComboBoxItem Content="9:16" Tag="0.5625"/><ComboBoxItem Content="Własne" Tag="custom"/></ComboBox>
   <StackPanel x:Name="CustomRatio" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8"><TextBox x:Name="RatioW" Text="5" Width="65" TextChanged="RatioCustom_Changed"/><TextBlock Text=" : " VerticalAlignment="Center"/><TextBox x:Name="RatioH" Text="4" Width="65" TextChanged="RatioCustom_Changed"/></StackPanel>
   <Button Content="Zaznacz cały obraz" Click="SelectAll_Click" Padding="7" Margin="0,0,0,14"/>
   <TextBlock Text="Szerokość wyjściowa (px)" FontWeight="SemiBold"/><TextBox x:Name="OutputWidth" Text="1200" Margin="0,6,0,5" Padding="6" TextChanged="Settings_Changed"/>
   <TextBlock x:Name="OutputSize" Text="Wysokość: —" Foreground="#687284" Margin="0,0,0,14"/>
   <TextBlock Text="Jakość WebP" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,6,0,12"><Slider x:Name="QualitySlider" Minimum="1" Maximum="100" Value="82" TickFrequency="1" IsSnapToTickEnabled="True" Width="190" ValueChanged="Settings_Changed"/><TextBlock x:Name="QualityText" Text="82%" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
   <CheckBox x:Name="LosslessBox" Content="Bezstratny WebP (PNG/alpha)" Margin="0,0,0,12" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
   <Button Content="Sprawdź wielkość pliku" Click="Estimate_Click" Padding="8" Margin="0,0,0,6"/><TextBlock x:Name="FileEstimate" Text="Rozmiar: —" Margin="0,0,0,14" Foreground="#687284"/>
   <Button Content="Zapisz jako WebP (Ctrl+S)" Click="Save_Click" Background="#1766CF" Foreground="White" FontWeight="SemiBold" Padding="12" BorderThickness="0"/>
   <TextBlock x:Name="Info" Text="Gotowy. Zaznacz kadr myszą." Foreground="#667085" TextWrapping="Wrap" Margin="0,16,0,0"/>
   <TextBlock Text="Mysz: przeciągnij, aby utworzyć kadr; przeciągnij wewnątrz ramki, aby go przesunąć. Nowy kadr zacznij poza ramką." TextWrapping="Wrap" Foreground="#667085" Margin="0,12,0,0" FontSize="12"/>
  </StackPanel></ScrollViewer></Border>
 </Grid>
</Window>
